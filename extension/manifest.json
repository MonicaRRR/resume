{
  "manifest_version": 3,
  "name": "简历工作台·一键填表",
  "version": "0.1.0",
  "description": "从本机经历库填写当前活动页的在线简历表单；缺项留空并提醒；不自动投递。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "一键填写当前页"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
